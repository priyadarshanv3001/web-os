# WebOS Environment Configuration
# Copy this file to .env and fill in the values

# --- Authentication (OTP) ---
# Using Brevo (Sendinblue) API
# If these are left blank, WebOS will run in SIMULATION MODE (OTP shown in terminal).
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER=your-verified-sender@email.com

# --- Security ---
SECRET_KEY=generate-a-secure-random-key-here

# --- Server ---
PORT=5000
FLASK_ENV=development
